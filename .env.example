# ---------------------------------------------------------------
# StudySpace – Konfiguration (Kopie als .env.local anlegen)
# ---------------------------------------------------------------
# Supabase Projekt-URL (Supabase → Project Settings → API / Data API)
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Publishable Key (beginnt mit "sb_publishable_..."). Alternativ der
# ältere "anon"-Key. NIEMALS den Secret- oder service_role-Key eintragen!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Maximale Uploadgröße pro Datei in MB. Muss zum Limit des Storage-
# Buckets passen (supabase/migrations/003_storage.sql, Standard 10).
VITE_MAX_UPLOAD_MB=10

# Öffentlicher VAPID-Schlüssel für Push-Benachrichtigungen (README, Schritt 12).
# Nur der PUBLIC Key gehört hierher – der private Schlüssel ist ein
# Secret der Supabase Edge Functions und darf nie ins Frontend.
# VITE_VAPID_PUBLIC_KEY=BExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nur für lokale Builds nötig: Unterpfad, unter dem die Seite liegt.
# GitHub Actions setzt den Wert automatisch.
# VITE_BASE_PATH=/Semester3/
